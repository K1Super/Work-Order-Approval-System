<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.workorder.com/process"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/BPMN20.xsd">

    <!--
        企业级多级审批流程
        支持6层组织架构：决策层→高管层→部门管理层→专业职能岗→一线执行岗→基层辅助岗
        审批规则通过approval_rule表配置，支持动态审批链路

        W-01 修复（fix-spec §3）：每个审批任务后增加排他网关 gw_xxx_result，
        首个条件判定 ${approved == false} → end_rejected，其余按审批链继续；
        end_rejected 已补齐 incoming 连线。
    -->
    <process id="enterprise_approval_process" name="企业级多级审批流程" isExecutable="true">

        <!-- 开始节点 -->
        <startEvent id="start" name="开始"/>

        <!-- 提交申请任务（申请人） -->
        <userTask id="submit_task" name="提交申请" flowable:assignee="${applicantId}"/>

        <!-- 动态审批网关 - 根据审批规则决定是否需要专业职能岗审核 -->
        <exclusiveGateway id="specialist_gateway" name="是否需要专项审核？"/>

        <!-- 专业职能岗审核节点 -->
        <userTask id="specialist_review" name="专项审核">
            <extensionElements>
                <flowable:taskListener event="create"
                        delegateExpression="${dynamicTaskAssigner}"/>
            </extensionElements>
        </userTask>

        <!-- 专项审核结果网关（W-01：驳回分流到 end_rejected） -->
        <exclusiveGateway id="gw_specialist_result" name="专项审核结果？"/>

        <!-- 部门经理审批节点 -->
        <userTask id="manager_approve" name="部门经理审批">
            <extensionElements>
                <flowable:taskListener event="create"
                        delegateExpression="${departmentManagerAssigner}"/>
            </extensionElements>
        </userTask>

        <!-- 部门经理审批结果网关（W-01） -->
        <exclusiveGateway id="gw_manager_result" name="部门经理审批结果？"/>

        <!-- 高管层审批网关 -->
        <exclusiveGateway id="director_gateway" name="是否需要总监/副总审批？"/>

        <!-- 总监/副总审批节点 -->
        <userTask id="director_approve" name="高管层审批">
            <extensionElements>
                <flowable:taskListener event="create"
                        delegateExpression="${directorAssigner}"/>
            </extensionElements>
        </userTask>

        <!-- 高管层审批结果网关（W-01） -->
        <exclusiveGateway id="gw_director_result" name="高管层审批结果？"/>

        <!-- 决策层终审网关 -->
        <exclusiveGateway id="executive_gateway" name="是否需要总经理/董事长终审？"/>

        <!-- 总经理/董事长终审节点 -->
        <userTask id="executive_approve" name="决策层终审">
            <extensionElements>
                <flowable:taskListener event="create"
                        delegateExpression="${executiveAssigner}"/>
            </extensionElements>
        </userTask>

        <!-- 决策层终审结果网关（W-01） -->
        <exclusiveGateway id="gw_executive_result" name="决策层终审结果？"/>

        <!-- 结束节点 -->
        <endEvent id="end_approved" name="审批通过"/>
        <endEvent id="end_rejected" name="审批驳回"/>

        <!-- 流程连线 -->

        <!-- 开始 -> 提交申请 -->
        <sequenceFlow id="flow_start_submit" sourceRef="start" targetRef="submit_task"/>

        <!-- 提交申请 -> 专项审核判断 -->
        <sequenceFlow id="flow_submit_specialist" sourceRef="submit_task" targetRef="specialist_gateway"/>

        <!-- 专项审核判断分支 -->
        <sequenceFlow id="flow_need_specialist" sourceRef="specialist_gateway" targetRef="specialist_review">
            <conditionExpression xsi:type="tFormalExpression">${needSpecialistReview == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_no_specialist" sourceRef="specialist_gateway" targetRef="manager_approve">
            <conditionExpression xsi:type="tFormalExpression">${needSpecialistReview == false || needSpecialistReview == null}</conditionExpression>
        </sequenceFlow>

        <!-- 专项审核 -> 专项审核结果网关 -->
        <sequenceFlow id="flow_specialist_result" sourceRef="specialist_review" targetRef="gw_specialist_result"/>

        <!-- 专项审核结果分支（W-01：驳回终止流程） -->
        <sequenceFlow id="flow_specialist_reject" sourceRef="gw_specialist_result" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_specialist_pass" sourceRef="gw_specialist_result" targetRef="manager_approve"/>

        <!-- 部门经理审批 -> 部门经理审批结果网关 -->
        <sequenceFlow id="flow_manager_result" sourceRef="manager_approve" targetRef="gw_manager_result"/>

        <!-- 部门经理审批结果分支（W-01：驳回终止流程） -->
        <sequenceFlow id="flow_manager_reject" sourceRef="gw_manager_result" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_manager_pass" sourceRef="gw_manager_result" targetRef="director_gateway"/>

        <!-- 高管层审批判断分支 -->
        <sequenceFlow id="flow_need_director" sourceRef="director_gateway" targetRef="director_approve">
            <conditionExpression xsi:type="tFormalExpression">${needDirectorApproval == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_no_director" sourceRef="director_gateway" targetRef="executive_gateway">
            <conditionExpression xsi:type="tFormalExpression">${needDirectorApproval == false || needDirectorApproval == null}</conditionExpression>
        </sequenceFlow>

        <!-- 高管层审批 -> 高管层审批结果网关 -->
        <sequenceFlow id="flow_director_result" sourceRef="director_approve" targetRef="gw_director_result"/>

        <!-- 高管层审批结果分支（W-01：驳回终止流程） -->
        <sequenceFlow id="flow_director_reject" sourceRef="gw_director_result" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_director_pass" sourceRef="gw_director_result" targetRef="executive_gateway"/>

        <!-- 决策层终审判断分支 -->
        <sequenceFlow id="flow_need_executive" sourceRef="executive_gateway" targetRef="executive_approve">
            <conditionExpression xsi:type="tFormalExpression">${needExecutiveApproval == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_no_executive" sourceRef="executive_gateway" targetRef="end_approved">
            <conditionExpression xsi:type="tFormalExpression">${needExecutiveApproval == false || needExecutiveApproval == null}</conditionExpression>
        </sequenceFlow>

        <!-- 决策层终审 -> 决策层终审结果网关 -->
        <sequenceFlow id="flow_executive_result" sourceRef="executive_approve" targetRef="gw_executive_result"/>

        <!-- 决策层终审结果分支（W-01：驳回终止流程，通过进入 end_approved） -->
        <sequenceFlow id="flow_executive_reject" sourceRef="gw_executive_result" targetRef="end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_executive_end" sourceRef="gw_executive_result" targetRef="end_approved"/>

    </process>

</definitions>
