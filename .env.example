# ============================================================
# 工单审批流转系统 — 环境变量样例
# 复制为 .env 并填入真实值；生产环境通过 Kubernetes Secrets / Vault 注入
# ============================================================

# ---------- 通用配置 ----------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- 数据库 (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=work_order_system
DB_USERNAME=postgres
DB_PASSWORD=666666

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=wos_redis_dev_pwd

# ---------- JWT 密钥 ----------
# 必须至少 32 字节（256 位）；生产环境建议 64 字节（512 位）
# 生成命令（PowerShell）:
#   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# 生成命令（Bash）:
#   openssl rand -base64 64
JWT_SECRET=WOS_Dev_K2026_HmacSha512_256bit_RndSalt!@#SecKey
JWT_EXPIRATION=86400000

# ---------- AES 加密密钥（手机号/邮箱字段加密） ----------
# 必须 32 字节（256 位）Base64 编码
# 生成命令（PowerShell）:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# 生成命令（Bash）:
#   openssl rand -base64 32
AES_ENCRYPTION_KEY=

# ---------- Redis Pub/Sub 消息签名密钥（Flowable 审批状态同步） ----------
# 必须 32 字节（256 位）
MESSAGE_SIGNING_KEY=

# ---------- CORS 白名单（逗号分隔） ----------
# 生产环境必须填写真实前端域名，禁止 *
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 应用层开关 ----------
# 是否启动时自动创建数据库（仅 dev=true，生产必须 false）
APP_DB_AUTO_CREATE=true

# ---------- 生产环境额外配置（可选） ----------
# LOG_FILE_PATH=/var/log/work-order-system
# MAX_FILE_SIZE=100MB
# MAX_HISTORY=30
