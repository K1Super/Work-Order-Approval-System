# ============================================================
# Work Order Approval System - Environment Variable Sample
# ============================================================
# Copy this file to `.env` and fill in real values.
#
# SECURITY: Do NOT commit real secrets. Every secret below is a
# placeholder. Production MUST generate an independent, strong
# random value for each environment (via Kubernetes Secrets,
# Vault, or your secret manager). Never reuse a secret across
# environments and never keep an example/default secret in use.

# ---------- General ----------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=work_order_system
DB_USERNAME=postgres
# Replace with a strong, environment-specific password.
DB_PASSWORD=<your-db-password>

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a local Redis without a password; set a strong one in production.
REDIS_PASSWORD=<your-redis-password>

# ---------- JWT ----------
# Strong random secret; 64 bytes (512-bit) Base64 is recommended.
# Generate: openssl rand -base64 64
JWT_SECRET=<generate-64-byte-base64-secret>
# Token lifetime in milliseconds (86400000 = 24 hours).
JWT_EXPIRATION=86400000

# ---------- AES / KEK field encryption ----------
# 32-byte (256-bit) Base64 key for AES-GCM sensitive-field encryption.
# Generate: openssl rand -base64 32
AES_ENCRYPTION_KEY=<generate-32-byte-base64-secret>
# Key Encrypting Key (32-byte Base64) that wraps per-record DEKs.
KEK_BASE64=<generate-32-byte-base64-secret>
# KEK source: "env" for local/development; use "vault"/KMS in production.
KEK_SOURCE=env
# Enable the startup DEK migration scan for legacy ciphertext.
DEK_MIGRATION_ENABLED=true

# ---------- CORS ----------
# Comma-separated allowed frontend origins.
# Production must list the real frontend domain; never use "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3000